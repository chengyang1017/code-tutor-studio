{
  "name": "code-tutor-studio-mobile",
  "private": true,
  "version": "0.1.0",
  "main": "./index.ts",
  "scripts": {
    "editor": "node scripts/build-editor.mjs",
    "start": "npm run editor && expo start --dev-client --localhost",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "android": "npm run editor && expo run:android",
    "apk:debug": "node scripts/build-android.mjs",
    "pretypecheck": "npm run editor",
    "typecheck": "tsc --noEmit",
    "test": "npm run editor && jest --runInBand",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "1.2.5",
    "codemirror": "^6.0.2",
    "expo": "~54.0.38",
    "expo-clipboard": "~8.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "testMatch": [
      "**/*.test.tsx"
    ]
  }
}
